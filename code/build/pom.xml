<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.zabrek.parent</groupId>
    <artifactId>versions</artifactId>
    <version>2.0.0</version>
  </parent>

  <name>SoulBound Build</name>
  <groupId>io.zabrek</groupId>
  <artifactId>soulbound</artifactId>
  <version>${revision}${changelist}</version>
  <description>Your best statistics Plugin</description>

  <properties>
    <revision>2.0.0</revision>
    <changelist>-SNAPSHOT</changelist>

    <maven-shade-plugin.path>${project.groupId}.${project.artifactId}</maven-shade-plugin.path>

    <!-- metadata -->
    <plugin.name>SoulBound</plugin.name>
    <plugin.main>${project.groupId}.${project.artifactId}.${plugin.name}Plugin</plugin.main>
    <plugin.version>${revision}-DEV-UNOFICCIAL</plugin.version>
    <plugin.api-version>1.21.1</plugin.api-version>
    <plugin.description>Your best RPG Plugin</plugin.description>

    <!-- module versions -->
    <soulbound-core.version>2.0.0${changelist}</soulbound-core.version>
    <!-- dependency versions -->
    <paper-api.version>1.21.1-R0.1-SNAPSHOT</paper-api.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.zabrek.soulbound</groupId>
      <artifactId>core</artifactId>
      <version>${soulbound-core.version}</version>
    </dependency>

    <!-- PaperMC Repository -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper-api.version}</version>
      <scope>provided</scope>

      <exclusions>
        <exclusion>
          <groupId>junit</groupId>
          <artifactId>junit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>soulbound-papermc-repo</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>soulbound-releases</id>
      <url>https://repo-soulbound.up.railway.app/releases</url>
    </repository>
  </repositories>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-banned-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.spigotmc</exclude>
                    <exclude>org.bukkit</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>${project.name}</finalName>
              <artifactSet>
                <includes>
                  <include>io.zabrek.soulbound</include>
                  <include>dev.faststats.metrics</include>
                  <include>com.zaxxer:HikariCP</include>
                </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>com.zaxxer</pattern>
                  <shadedPattern>${maven-shade-plugin.path}.dependencies.com.zaxxer</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-jar-files</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target name="copy .jar files to root">
                <copy toDir="../../target/code"
                      overwrite="true"
                      quiet="true"
                      verbose="true"
                      failonerror="false"
                      preservelastmodified="true">
                  <fileset dir="../">
                    <include name="*/target/code/*.jar"/>
                  </fileset>
                  <filtermapper>
                    <replacestring from="target/code/" to=""/>
                  </filtermapper>
                </copy>
                <copy file="${project.build.directory}/${project.name}.jar"
                      tofile="../../target/code/SoulBound.jar"
                      overwrite="true"
                      quiet="true"
                      verbose="true"
                      failonerror="false"
                      preservelastmodified="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
