<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.zabrek.parent</groupId>
    <artifactId>versions</artifactId>
    <version>2.0.0</version>
  </parent>

  <name>SoulBound Library</name>
  <groupId>io.zabrek.soulbound</groupId>
  <artifactId>lib</artifactId>
  <version>${revision}${changelist}</version>
  <description>Provides the library of SoulBound</description>

  <properties>
    <revision>2.0.0</revision>
    <changelist>-SNAPSHOT</changelist>

    <!-- module version -->
    <soulbound.api.version>2.0.0${changelist}</soulbound.api.version>

    <!-- dependency versions -->
    <paper-api.version>1.21.1-R0.1-SNAPSHOT</paper-api.version>
    <log4j-api.version>2.25.5</log4j-api.version>
    <log4j-core.version>2.25.5</log4j-core.version>
  </properties>

  <dependencies>
    <!-- from soulbound module -->
    <dependency>
      <groupId>io.zabrek.soulbound</groupId>
      <artifactId>api</artifactId>
      <version>${soulbound.api.version}</version>
    </dependency>

    <!-- from papermc repository -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper-api.version}</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>junit</groupId>
          <artifactId>junit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>${log4j-api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j-core.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>souldbound-papermc-repo</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>maven_central</id>
      <name>Maven Central</name>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>soulbound-releases</id>
      <url>https://repo-soulbound.up.railway.app/releases</url>
    </repository>
  </repositories>
</project>
